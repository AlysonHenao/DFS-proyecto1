# Copiar a .env (no subir .env a git). Ver docs/decisions.md para el detalle.

# --- Politica del cluster (ControlNode) ---
BLOCK_SIZE_BYTES=65536
REPLICATION_FACTOR=2
MIN_WRITE_ACKS=2
HEARTBEAT_INTERVAL_S=5
DEAD_TIMEOUT_S=15
CHUNK_SIZE_BYTES=524288

# --- Seguridad (cambiar en cada despliegue) ---
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRE_MIN=60
CLUSTER_API_KEY=cambiar-por-otra-clave-larga
# 32 bytes en base64:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# En desarrollo todos los DataNodes comparten esta llave; en produccion, una distinta por DataNode.
DATANODE_MASTER_KEY=

# --- ControlNodes (activo/standby) ---
CONTROLNODE_ID=control-leader
CONTROLNODE_ROLE=leader
CONTROL_REST_PORT=8000
CONTROL_GRPC_PORT=50050
DB_PATH=/data/meta.db
CONTROL_PEER_GRPC_ADDR=control-follower:50050
CONTROL_LEADER_URL=http://control-leader:8000

# --- DataNode (DATANODE_ID y DATANODE_ADDR se fijan por servicio en el compose) ---
CONTROL_GRPC_ADDR=control-leader:50050
DATANODE_PORT=50051
DATANODE_DATA_DIR=/data

# --- Cliente ---
DFSHA_CONTROL_URL=http://control-leader:8000

# --- TLS (activar en la fase 2) ---
TLS_ENABLED=false
TLS_CERT=
TLS_KEY=
TLS_CA=
